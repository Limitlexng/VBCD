# ─── App ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
APP_NAME=BerryX
APP_URL=https://berryx.app
ADMIN_URL=https://admin.berryx.app

# ─── Database ─────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=berryx
DB_PASSWORD=change_me_in_production
DB_NAME=berryx_db
DB_SSL=false
# DB_SSL_CA=/path/to/ca.pem   # Required in production (e.g. Railway, RDS)

# ─── Redis ────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change_me_in_production
REDIS_TLS=false

# ─── JWT ──────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=generate_a_64_byte_hex_secret
JWT_REFRESH_SECRET=generate_a_different_64_byte_hex_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Encryption ───────────────────────────────────────────────────────────
# 32-byte key for AES-256 encryption of sensitive fields (BVN, NIN, etc.)
ENCRYPTION_KEY=generate_a_32_byte_hex_key_here

# ─── Paystack ─────────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=your_webhook_secret

# ─── Monnify ──────────────────────────────────────────────────────────────
MONNIFY_API_KEY=MK_TEST_xxxxxxxxxxxx
MONNIFY_SECRET_KEY=your_monnify_secret
MONNIFY_CONTRACT_CODE=your_contract_code
MONNIFY_BASE_URL=https://sandbox.monnify.com

# ─── Flutterwave ──────────────────────────────────────────────────────────
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxx-X
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxx-X
FLUTTERWAVE_ENCRYPTION_KEY=your_encryption_key
FLUTTERWAVE_WEBHOOK_HASH=your_webhook_hash

# ─── VTPass (Bills — Airtime/Data/Electricity/Cable) ──────────────────────
VTPASS_API_KEY=your_vtpass_api_key
VTPASS_SECRET_KEY=your_vtpass_secret_key
VTPASS_PUBLIC_KEY=your_vtpass_public_key
VTPASS_BASE_URL=https://sandbox.vtpass.com/api

# ─── Buypower (Electricity alternative) ──────────────────────────────────
BUYPOWER_API_KEY=your_buypower_api_key
BUYPOWER_BASE_URL=https://api.buypower.ng/v1

# ─── Binance Pay (Crypto) ─────────────────────────────────────────────────
BINANCE_PAY_API_KEY=your_binance_pay_api_key
BINANCE_PAY_SECRET_KEY=your_binance_pay_secret_key
BINANCE_PAY_WEBHOOK_KEY=your_binance_webhook_key

# ─── Twilio (SMS) ─────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
# Alternative: Termii (Nigerian SMS gateway)
TERMII_API_KEY=your_termii_api_key

# ─── SendGrid (Email) ─────────────────────────────────────────────────────
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxx
SENDGRID_FROM_EMAIL=noreply@berryx.app
SENDGRID_FROM_NAME=BerryX

# ─── Firebase (Push Notifications) ───────────────────────────────────────
FIREBASE_PROJECT_ID=berryx-app
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@berryx-app.iam.gserviceaccount.com

# ─── Smile Identity (KYC — BVN/NIN verification) ─────────────────────────
SMILE_PARTNER_ID=your_smile_partner_id
SMILE_API_KEY=your_smile_api_key

# ─── NIBSS / PremiumTrust (Direct BVN Lookup) ────────────────────────────
BVN_VERIFICATION_KEY=your_bvn_verification_key

# ─── Sentry (Error Tracking) ──────────────────────────────────────────────
SENTRY_DSN=https://xxxxx@o0.ingest.sentry.io/0
SENTRY_ENVIRONMENT=development

# ─── Rate Limiting ────────────────────────────────────────────────────────
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# ─── Queue ────────────────────────────────────────────────────────────────
BULL_BOARD_USER=admin
BULL_BOARD_PASSWORD=change_me_in_production

# ─── Frontend (apps/web) ──────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:3001
NEXT_PUBLIC_SENTRY_DSN=

# ─── Frontend (apps/admin) ────────────────────────────────────────────────
NEXT_PUBLIC_ADMIN_API_URL=http://localhost:3001/api/v1

# ─── Docker / Registry (CI/CD) ───────────────────────────────────────────
REGISTRY=ghcr.io/your-org
IMAGE_TAG=latest

# ─── Misc ─────────────────────────────────────────────────────────────────
# Minimum NGN balance for withdrawal (kobo)
MIN_WITHDRAWAL_AMOUNT=50000
# Maximum wallet balance (NGN, kobo) for Tier 0
TIER_0_MAX_BALANCE=30000000
